<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar: each screen has its own heading, and a TV has little height to spare. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:buttonStyle">@style/RemoteButton</item>
        <item name="android:listViewStyle">@style/RemoteList</item>
        <item name="android:textAppearanceListItem">@android:style/TextAppearance.DeviceDefault.Medium</item>
        <item name="android:listPreferredItemHeight">44dp</item>
    </style>

    <style name="RemoteButton" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="RemoteList" parent="@android:style/Widget.DeviceDefault.ListView">
        <item name="android:listSelector">@drawable/list_selector</item>
        <item name="android:drawSelectorOnTop">false</item>
        <item name="android:divider">@android:color/transparent</item>
        <item name="android:dividerHeight">4dp</item>
    </style>
</resources>
