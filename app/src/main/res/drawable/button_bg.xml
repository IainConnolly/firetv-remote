<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/pressed_fill" />
            <stroke android:width="4dp" android:color="@color/focus_edge" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/focus_fill" />
            <stroke android:width="4dp" android:color="@color/focus_edge" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/button_fill" />
            <stroke android:width="1dp" android:color="@color/button_edge" />
        </shape>
    </item>
</selector>
